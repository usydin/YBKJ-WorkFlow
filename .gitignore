# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
build/
dist/
*.spec

# macOS
.DS_Store

# Logs
logs/*.log

# Runtime database
datapool/sqlite/*.db
datapool/sqlite/*.sqlite
datapool/sqlite/*.sqlite3

# Outputs
outputs/excel/*
outputs/word/*
outputs/pdf/*
outputs/text/*
reports/daily/*
reports/statistics/*
datapool/exports_history/*
datapool/jsonl/*

# Keep directories
!outputs/excel/.gitkeep
!outputs/word/.gitkeep
!outputs/pdf/.gitkeep
!outputs/text/.gitkeep
!reports/daily/.gitkeep
!reports/statistics/.gitkeep
!datapool/exports_history/.gitkeep
!datapool/jsonl/.gitkeep

# Model runtime files
model_pack/current/*
model_pack/versions/*

# Keep model directories
!model_pack/current/.gitkeep
!model_pack/versions/.gitkeep

# Local config
config.local.json
.env

# Local sample images
dataset/samples/screenshots_raw/*
!dataset/samples/screenshots_raw/.gitkeep

# IDE
.idea/
.vscode/

# SQLite runtime sidecar files
datapool/sqlite/*.db-wal
datapool/sqlite/*.db-shm
datapool/sqlite/*.sqlite-wal
datapool/sqlite/*.sqlite-shm
datapool/sqlite/*.sqlite3-wal
datapool/sqlite/*.sqlite3-shm
